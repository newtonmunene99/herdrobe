{
  "layout:vscode": {
    "cmd-shift-e": "vscode-activitybar.files",
    "cmd-shift-g": "vscode-activitybar.changes",
    "cmd-shift-l": "vscode-statusbar.layouts",
    "cmd-shift-h": "vscode-statusbar.history",
    "ctrl-cmd-left": { "command": "pane.swap", "args": { "direction": "left" } },
    "ctrl-cmd-right": { "command": "pane.swap", "args": { "direction": "right" } },
    "ctrl-cmd-up": { "command": "pane.swap", "args": { "direction": "up" } },
    "ctrl-cmd-down": { "command": "pane.swap", "args": { "direction": "down" } }
  },
  "layout:vscode-inbox": {
    "cmd-shift-a": "vscode-activitybar.agents",
    "cmd-shift-e": "vscode-activitybar.files",
    "cmd-shift-g": "vscode-activitybar.changes",
    "cmd-shift-h": "vscode-activitybar.history",
    "cmd-shift-l": "vscode-statusbar.layouts",
    "ctrl-cmd-left": { "command": "pane.swap", "args": { "direction": "left" } },
    "ctrl-cmd-right": { "command": "pane.swap", "args": { "direction": "right" } },
    "ctrl-cmd-up": { "command": "pane.swap", "args": { "direction": "up" } },
    "ctrl-cmd-down": { "command": "pane.swap", "args": { "direction": "down" } }
  }
}
